#!/usr/bin/env python3
"""Deterministic verifier and append-only shadow log for the local pipeline."""

from __future__ import annotations

import argparse
import copy
import datetime as dt
import fnmatch
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import time
from typing import Any


SCHEMA_VERSION = 1
TIERS = ("T0", "T1", "T2")
STATUSES = ("CHECKS_PASS", "CHECKS_FAIL", "INCOMPLETE")
MAX_OUTPUT_CHARS = 8000

try:
    import jsonschema
except ImportError:  # Reported as INCOMPLETE by the schema check.
    jsonschema = None


def run_process(command: list[str], cwd: Path) -> tuple[int, str, int]:
    started = time.monotonic()
    completed = subprocess.run(
        command,
        cwd=cwd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        errors="replace",
        check=False,
    )
    duration_ms = round((time.monotonic() - started) * 1000)
    return completed.returncode, completed.stdout[-MAX_OUTPUT_CHARS:], duration_ms


def git_root() -> Path:
    completed = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError("pipeline-check must run inside a Git worktree")
    return Path(completed.stdout.strip()).resolve()


def git_bytes(root: Path, arguments: list[str]) -> bytes:
    completed = subprocess.run(
        ["git", *arguments],
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.returncode != 0:
        raise RuntimeError(completed.stderr.decode(errors="replace"))
    return completed.stdout


def resolve_commit(root: Path, revision: str) -> str:
    if not re.fullmatch(r"[0-9a-fA-F]{40,64}", revision):
        raise ValueError("--base-revision must be a full immutable commit SHA")
    resolved = git_bytes(
        root, ["rev-parse", "--verify", f"{revision}^{{commit}}"]
    ).decode().strip()
    if resolved.lower() != revision.lower():
        raise ValueError("--base-revision must resolve to the exact commit SHA")
    return resolved.lower()


def head_revision(root: Path) -> str:
    return git_bytes(root, ["rev-parse", "--verify", "HEAD^{commit}"]).decode().strip()


def parse_name_status(payload: bytes) -> list[str]:
    tokens = payload.split(b"\0")
    paths: list[str] = []
    index = 0
    while index < len(tokens) and tokens[index]:
        change = tokens[index].decode(errors="replace")
        index += 1
        if index >= len(tokens) or not tokens[index]:
            raise RuntimeError("Malformed git --name-status output")
        paths.append(tokens[index].decode(errors="surrogateescape"))
        index += 1
        if change.startswith(("R", "C")):
            if index >= len(tokens) or not tokens[index]:
                raise RuntimeError("Malformed git rename/copy output")
            paths.append(tokens[index].decode(errors="surrogateescape"))
            index += 1
    return paths


def changed_files(root: Path, base_revision: str) -> list[str]:
    paths: list[str] = []
    paths.extend(
        parse_name_status(
            git_bytes(
                root,
                ["diff", "--name-status", "-z", "--find-renames", f"{base_revision}..HEAD"],
            )
        )
    )
    paths.extend(
        parse_name_status(
            git_bytes(
                root,
                ["diff", "--cached", "--name-status", "-z", "--find-renames", "HEAD"],
            )
        )
    )
    paths.extend(
        parse_name_status(
            git_bytes(root, ["diff", "--name-status", "-z", "--find-renames"])
        )
    )
    untracked = git_bytes(
        root, ["ls-files", "--others", "--exclude-standard", "-z"]
    ).split(b"\0")
    paths.extend(
        item.decode(errors="surrogateescape") for item in untracked if item
    )
    return sorted(set(paths))


def matches_allowed(path: str, patterns: list[str]) -> bool:
    return any(fnmatch.fnmatchcase(path, pattern) for pattern in patterns)


def tree_entry(root: Path, revision: str, relative: str) -> dict[str, str]:
    payload = git_bytes(root, ["ls-tree", "-z", revision, "--", relative])
    if not payload:
        return {"state": "deleted"}
    header, _, returned_path = payload.rstrip(b"\0").partition(b"\t")
    mode, kind, object_id = header.decode().split(" ", 2)
    return {
        "state": "present",
        "mode": mode,
        "kind": kind,
        "object": object_id,
        "path": returned_path.decode(errors="surrogateescape"),
    }


def index_entries(root: Path, relative: str) -> list[dict[str, str]]:
    payload = git_bytes(root, ["ls-files", "--stage", "-z", "--", relative])
    entries: list[dict[str, str]] = []
    for record in payload.split(b"\0"):
        if not record:
            continue
        header, _, returned_path = record.partition(b"\t")
        mode, object_id, stage = header.decode().split(" ", 2)
        entries.append(
            {
                "mode": mode,
                "object": object_id,
                "stage": stage,
                "path": returned_path.decode(errors="surrogateescape"),
            }
        )
    return entries


def worktree_entry(root: Path, relative: str) -> dict[str, Any]:
    target = root / relative
    try:
        metadata = target.lstat()
    except FileNotFoundError:
        return {"state": "deleted"}

    mode = f"{stat.S_IFMT(metadata.st_mode):o}:{stat.S_IMODE(metadata.st_mode):04o}"
    if stat.S_ISLNK(metadata.st_mode):
        return {
            "state": "symlink",
            "mode": mode,
            "target": os.readlink(target),
        }
    if stat.S_ISREG(metadata.st_mode):
        digest = hashlib.sha256()
        with target.open("rb") as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(chunk)
        return {
            "state": "file",
            "mode": mode,
            "size": metadata.st_size,
            "sha256": digest.hexdigest(),
        }
    return {"state": "other", "mode": mode}


def implementation_manifest(
    root: Path,
    base_revision: str,
    current_head: str,
    paths: list[str],
) -> list[dict[str, Any]]:
    return [
        {
            "path": relative,
            "base": tree_entry(root, base_revision, relative),
            "head": tree_entry(root, current_head, relative),
            "index": index_entries(root, relative),
            "worktree": worktree_entry(root, relative),
        }
        for relative in sorted(paths)
    ]


def canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode()


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def worktree_fingerprint(
    root: Path, base_revision: str, paths: list[str]
) -> tuple[str, str, list[dict[str, Any]]]:
    current_head = head_revision(root)
    manifest = implementation_manifest(root, base_revision, current_head, paths)
    payload = {
        "base_revision": base_revision,
        "head_revision": current_head,
        "files": manifest,
    }
    digest = hashlib.sha256(canonical_json(payload)).hexdigest()
    return f"worktree-sha256:{digest}", current_head, manifest


def check_record(
    check_id: str,
    command: list[str],
    root: Path,
    *,
    missing_is_incomplete: bool = True,
) -> dict[str, Any]:
    executable = shutil.which(command[0])
    rendered = " ".join(command)
    if executable is None:
        return {
            "id": check_id,
            "command": rendered,
            "status": "INCOMPLETE" if missing_is_incomplete else "SKIPPED",
            "exit_code": None,
            "duration_ms": 0,
            "output_tail": f"Executable not found: {command[0]}",
        }
    exit_code, output, duration_ms = run_process(command, root)
    return {
        "id": check_id,
        "command": rendered,
        "status": "PASS" if exit_code == 0 else "FAIL",
        "exit_code": exit_code,
        "duration_ms": duration_ms,
        "output_tail": output,
    }


def safe_component(value: str) -> str:
    normalized = re.sub(r"[^A-Za-z0-9._-]+", "-", value).strip(".-")
    return normalized[:120] or "unnamed"


def state_root(root: Path) -> Path:
    git_dir = subprocess.run(
        ["git", "rev-parse", "--git-dir"],
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=True,
    ).stdout.strip()
    resolved = Path(git_dir)
    if not resolved.is_absolute():
        resolved = root / resolved
    return resolved.resolve() / "opencode-pipeline"


def append_event(root: Path, event: dict[str, Any]) -> Path:
    target = state_root(root) / "events.jsonl"
    target.parent.mkdir(parents=True, exist_ok=True)
    with target.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")
    return target


def result_schema_path() -> Path:
    return Path(__file__).resolve().parent.parent / "workflow" / "check-result.schema.json"


def result_validator() -> Any:
    if jsonschema is None:
        raise RuntimeError("jsonschema with Draft 2020-12 support is required")
    schema = json.loads(result_schema_path().read_text(encoding="utf-8"))
    validator_class = jsonschema.validators.validator_for(schema)
    if validator_class is not jsonschema.Draft202012Validator:
        raise RuntimeError("check-result schema must use JSON Schema Draft 2020-12")
    validator_class.check_schema(schema)
    format_checker = jsonschema.FormatChecker()

    @format_checker.checks("date-time", raises=ValueError)
    def is_timezone_aware_datetime(value: object) -> bool:
        if not isinstance(value, str):
            return True
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        return parsed.tzinfo is not None

    return validator_class(schema, format_checker=format_checker)


def validate_result(result: dict[str, Any], validator: Any) -> None:
    errors = sorted(
        validator.iter_errors(result),
        key=lambda item: tuple(str(component) for component in item.path),
    )
    if errors:
        details = "; ".join(error.message for error in errors[:5])
        raise ValueError(f"check result violates Draft 2020-12 schema: {details}")
    expected_id = result_id_for(result)
    if result["result_id"] != expected_id:
        raise ValueError(
            f"check result ID does not match canonical payload: expected {expected_id}"
        )


def result_identity_payload(result: dict[str, Any]) -> dict[str, Any]:
    return {
        "schema_version": result["schema_version"],
        "scope_id": result["scope_id"],
        "attempt_id": result["attempt_id"],
        "initial_tier": result["initial_tier"],
        "current_tier": result["current_tier"],
        "base_revision": result["base_revision"],
        "head_revision": result["head_revision"],
        "contract_revision": result["contract_revision"],
        "implementation_revision": result["implementation_revision"],
        "status": result["status"],
        "changed_files": result["changed_files"],
        "out_of_scope_files": result["out_of_scope_files"],
        "allowed_paths": result["allowed_paths"],
        "openspec_change": result["openspec_change"],
        "check_configuration": result["check_configuration"],
        # Durations and diagnostic output are deliberately excluded: repeated
        # execution with identical inputs and pass/fail outcomes is idempotent.
        "checks": [
            {
                "id": check["id"],
                "command": check["command"],
                "status": check["status"],
                "exit_code": check["exit_code"],
            }
            for check in result["checks"]
        ],
    }


def result_id_for(result: dict[str, Any]) -> str:
    digest = hashlib.sha256(canonical_json(result_identity_payload(result))).hexdigest()
    return f"check-{digest}"


def write_result(
    root: Path, result: dict[str, Any], validator: Any
) -> tuple[Path, dict[str, Any]]:
    results_dir = state_root(root) / "results"
    results_dir.mkdir(parents=True, exist_ok=True)
    target = results_dir / f"{safe_component(result['result_id'])}.json"
    serialized = json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    try:
        with target.open("x", encoding="utf-8") as stream:
            stream.write(serialized)
        return target, result
    except FileExistsError:
        existing = json.loads(target.read_text(encoding="utf-8"))
        validate_result(existing, validator)
        if (
            existing.get("result_id") != result["result_id"]
            or result_identity_payload(existing) != result_identity_payload(result)
        ):
            raise RuntimeError(
                f"immutable result collision; refusing to overwrite {target}"
            )
        return target, existing


def result_status(checks: list[dict[str, Any]]) -> str:
    if any(check["status"] == "FAIL" for check in checks):
        return "CHECKS_FAIL"
    if any(check["status"] == "INCOMPLETE" for check in checks):
        return "INCOMPLETE"
    return "CHECKS_PASS"


def run_checks(args: argparse.Namespace) -> int:
    root = git_root()
    if not args.allowed_path:
        raise ValueError("At least one --allowed-path is required")
    validator = result_validator()
    base_revision = resolve_commit(root, args.base_revision)

    before_paths = changed_files(root, base_revision)
    before_revision, before_head, _ = worktree_fingerprint(
        root, base_revision, before_paths
    )
    outside = [
        path for path in before_paths if not matches_allowed(path, args.allowed_path)
    ]
    checks: list[dict[str, Any]] = [
        {
            "id": "scope",
            "command": "analyze base..HEAD + index + worktree + untracked paths",
            "status": "PASS" if not outside else "FAIL",
            "exit_code": 0 if not outside else 1,
            "duration_ms": 0,
            "output_tail": "" if not outside else "Out of scope: " + ", ".join(outside),
        }
    ]

    if args.openspec_change:
        checks.append(
            check_record(
                "openspec",
                ["openspec", "validate", args.openspec_change],
                root,
            )
        )
    else:
        checks.append(
            {
                "id": "openspec",
                "command": "openspec validate <change>",
                "status": "SKIPPED",
                "exit_code": None,
                "duration_ms": 0,
                "output_tail": "No OpenSpec change is attached to this scope",
            }
        )

    if not args.no_flutter:
        checks.extend(
            [
                check_record(
                    "dart-format",
                    ["dart", "format", "--output=none", "--set-exit-if-changed", "."],
                    root,
                ),
                check_record("flutter-analyze", ["flutter", "analyze"], root),
                check_record("flutter-test", ["flutter", "test"], root),
            ]
        )

    after_paths = changed_files(root, base_revision)
    after_revision, after_head, _ = worktree_fingerprint(
        root, base_revision, after_paths
    )
    unchanged = (
        before_paths == after_paths
        and before_revision == after_revision
        and before_head == after_head
    )
    checks.append(
        {
            "id": "worktree-unchanged",
            "command": "compare pre/post worktree fingerprint",
            "status": "PASS" if unchanged else "FAIL",
            "exit_code": 0 if unchanged else 1,
            "duration_ms": 0,
            "output_tail": "" if unchanged else "Verification changed the Git worktree",
        }
    )

    checks.append(
        {
            "id": "result-schema",
            "command": "Draft 2020-12 check-result.schema.json validation",
            "status": "PASS",
            "exit_code": 0,
            "duration_ms": 0,
            "output_tail": "",
        }
    )
    now = dt.datetime.now(dt.timezone.utc).isoformat()
    result = {
        "schema_version": SCHEMA_VERSION,
        "result_id": "check-" + "0" * 64,
        "scope_id": args.scope_id,
        "attempt_id": args.attempt_id,
        "initial_tier": args.initial_tier,
        "current_tier": args.current_tier,
        "base_revision": base_revision,
        "head_revision": after_head,
        "contract_revision": args.contract_revision,
        "implementation_revision": after_revision,
        "status": result_status(checks),
        "generated_at": now,
        "changed_files": after_paths,
        "out_of_scope_files": outside,
        "allowed_paths": sorted(set(args.allowed_path)),
        "openspec_change": args.openspec_change,
        "check_configuration": {
            "flutter_checks": not args.no_flutter,
            "openspec_required": args.openspec_change is not None,
            "runner_sha256": file_sha256(Path(__file__).resolve()),
            "schema_sha256": file_sha256(result_schema_path()),
        },
        "checks": checks,
    }
    result["result_id"] = result_id_for(result)
    validate_result(result, validator)
    result_path, persisted_result = write_result(root, result, validator)
    event = {
        "schema_version": SCHEMA_VERSION,
        "event_type": "checks_completed",
        "generated_at": now,
        "scope_id": args.scope_id,
        "attempt_id": args.attempt_id,
        "initial_tier": args.initial_tier,
        "current_tier": args.current_tier,
        "base_revision": base_revision,
        "contract_revision": args.contract_revision,
        "implementation_revision": persisted_result["implementation_revision"],
        "result_id": persisted_result["result_id"],
        "check_status": persisted_result["status"],
        "model_tiers_used": sorted(set(args.model_tier_used)),
        "rework_count": args.rework_count,
        "escalation_reason": args.escalation_reason,
    }
    event_path = append_event(root, event)
    payload = {
        **persisted_result,
        "result_path": str(result_path),
        "event_log_path": str(event_path),
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    return {"CHECKS_PASS": 0, "CHECKS_FAIL": 1, "INCOMPLETE": 2}[
        persisted_result["status"]
    ]


def record_event(args: argparse.Namespace) -> int:
    root = git_root()
    base_revision = resolve_commit(root, args.base_revision)
    if args.record_event == "reviewed":
        for value, flag in (
            (args.implementation_revision, "--implementation-revision"),
            (args.result_id, "--result-id"),
            (args.verdict, "--verdict"),
        ):
            require(value, flag)
    if args.record_event == "escalated":
        require(args.escalation_reason, "--escalation-reason")
    event = {
        "schema_version": SCHEMA_VERSION,
        "event_type": args.record_event,
        "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "scope_id": args.scope_id,
        "attempt_id": args.attempt_id,
        "initial_tier": args.initial_tier,
        "current_tier": args.current_tier,
        "base_revision": base_revision,
        "contract_revision": args.contract_revision,
        "implementation_revision": args.implementation_revision,
        "result_id": args.result_id,
        "verdict": args.verdict,
        "model_tiers_used": sorted(set(args.model_tier_used)),
        "rework_count": args.rework_count,
        "escalation_reason": args.escalation_reason,
    }
    target = append_event(root, event)
    print(json.dumps({"event_log_path": str(target), "event": event}, indent=2))
    return 0


def self_test() -> int:
    validator = result_validator()
    schema_path = result_schema_path()
    assert matches_allowed("lib/a.dart", ["lib/**"])
    assert not matches_allowed("test/a.dart", ["lib/**"])
    assert safe_component("scope/a b") == "scope-a-b"
    assert result_status([{"status": "PASS"}, {"status": "SKIPPED"}]) == "CHECKS_PASS"
    assert result_status([{"status": "INCOMPLETE"}]) == "INCOMPLETE"
    assert result_status([{"status": "FAIL"}]) == "CHECKS_FAIL"
    assert parse_name_status(b"M\0a.txt\0R100\0old.txt\0new.txt\0") == [
        "a.txt",
        "old.txt",
        "new.txt",
    ]

    valid = {
        "schema_version": 1,
        "result_id": "check-" + "0" * 64,
        "scope_id": "self-test",
        "attempt_id": "attempt-1",
        "initial_tier": "T1",
        "current_tier": "T2",
        "base_revision": "1" * 40,
        "head_revision": "2" * 40,
        "contract_revision": "contract-r1",
        "implementation_revision": "worktree-sha256:" + "3" * 64,
        "status": "CHECKS_PASS",
        "generated_at": "2026-09-11T12:00:00+00:00",
        "changed_files": ["lib/a.dart"],
        "out_of_scope_files": [],
        "allowed_paths": ["lib/**"],
        "openspec_change": None,
        "check_configuration": {
            "flutter_checks": True,
            "openspec_required": False,
            "runner_sha256": "4" * 64,
            "schema_sha256": "5" * 64,
        },
        "checks": [
            {
                "id": "scope",
                "command": "scope check",
                "status": "PASS",
                "exit_code": 0,
                "duration_ms": 0,
                "output_tail": "",
            }
        ],
    }
    valid["result_id"] = result_id_for(valid)
    validate_result(valid, validator)
    invalid_cases: list[dict[str, Any]] = []
    missing_base = copy.deepcopy(valid)
    del missing_base["base_revision"]
    invalid_cases.append(missing_base)
    bad_tier = copy.deepcopy(valid)
    bad_tier["current_tier"] = "T3"
    invalid_cases.append(bad_tier)
    extra_property = copy.deepcopy(valid)
    extra_property["unexpected"] = True
    invalid_cases.append(extra_property)
    duplicate_paths = copy.deepcopy(valid)
    duplicate_paths["allowed_paths"] = ["lib/**", "lib/**"]
    invalid_cases.append(duplicate_paths)
    bad_check = copy.deepcopy(valid)
    bad_check["checks"][0]["status"] = "APPROVED"
    invalid_cases.append(bad_check)
    bad_date = copy.deepcopy(valid)
    bad_date["generated_at"] = "not-a-date"
    invalid_cases.append(bad_date)
    for invalid in invalid_cases:
        if not list(validator.iter_errors(invalid)):
            raise AssertionError(f"negative schema case unexpectedly passed: {invalid}")

    base_identity = hashlib.sha256(canonical_json(result_identity_payload(valid))).digest()
    for field, value in (
        ("current_tier", "T1"),
        ("allowed_paths", ["test/**"]),
        (
            "check_configuration",
            {
                "flutter_checks": False,
                "openspec_required": False,
                "runner_sha256": "4" * 64,
                "schema_sha256": "5" * 64,
            },
        ),
    ):
        changed = copy.deepcopy(valid)
        changed[field] = value
        changed_identity = hashlib.sha256(
            canonical_json(result_identity_payload(changed))
        ).digest()
        if changed_identity == base_identity:
            raise AssertionError(f"identity does not include {field}")
    changed_result = copy.deepcopy(valid)
    changed_result["checks"][0]["status"] = "FAIL"
    changed_result["checks"][0]["exit_code"] = 1
    changed_result_identity = hashlib.sha256(
        canonical_json(result_identity_payload(changed_result))
    ).digest()
    if changed_result_identity == base_identity:
        raise AssertionError("identity does not include check results")

    print(
        json.dumps(
            {
                "status": "SELF_TEST_PASS",
                "schema": str(schema_path),
                "negative_schema_cases": len(invalid_cases),
            }
        )
    )
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="Run deterministic repository checks and write a Git-local result"
    )
    result.add_argument("--self-test", action="store_true")
    result.add_argument(
        "--record-event", choices=("routed", "escalated", "reviewed")
    )
    result.add_argument("--scope-id")
    result.add_argument("--attempt-id")
    result.add_argument("--initial-tier", choices=TIERS)
    result.add_argument("--current-tier", choices=TIERS)
    result.add_argument("--base-revision")
    result.add_argument("--contract-revision")
    result.add_argument("--implementation-revision")
    result.add_argument("--result-id")
    result.add_argument(
        "--verdict",
        choices=(
            "APPROVED",
            "APPROVED_WITH_NOTES",
            "CHANGES_REQUIRED",
            "BLOCKED_BY_SPEC",
            "ESCALATED",
        ),
    )
    result.add_argument("--allowed-path", action="append", default=[])
    result.add_argument("--openspec-change")
    result.add_argument("--model-tier-used", action="append", default=[])
    result.add_argument("--rework-count", type=int, default=0)
    result.add_argument("--escalation-reason")
    result.add_argument(
        "--no-flutter",
        action="store_true",
        help="Skip Flutter checks for config/tooling-only scopes",
    )
    return result


def require(value: Any, flag: str) -> None:
    if value is None or value == "":
        raise ValueError(f"{flag} is required")


def main() -> int:
    args = parser().parse_args()
    if args.self_test:
        return self_test()
    for value, flag in (
        (args.scope_id, "--scope-id"),
        (args.attempt_id, "--attempt-id"),
        (args.initial_tier, "--initial-tier"),
        (args.current_tier, "--current-tier"),
        (args.base_revision, "--base-revision"),
        (args.contract_revision, "--contract-revision"),
    ):
        require(value, flag)
    if TIERS.index(args.current_tier) < TIERS.index(args.initial_tier):
        raise ValueError("--current-tier cannot be lower than --initial-tier")
    if args.record_event:
        return record_event(args)
    return run_checks(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print(json.dumps({"status": "INCOMPLETE", "error": str(error)}), file=sys.stderr)
        raise SystemExit(2)
