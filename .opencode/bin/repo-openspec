#!/usr/bin/env python3
"""Run one fixed read-only OpenSpec operation without shell interpretation."""

from __future__ import annotations

import json
from pathlib import Path
import shutil
import subprocess
import sys


ALLOWED_COMMANDS = {
    "context",
    "doctor",
    "instructions",
    "list",
    "schemas",
    "show",
    "status",
    "templates",
    "validate",
}
FORBIDDEN_FLAGS = {"--fix", "--output", "--write", "-o"}
FORBIDDEN_PREFIXES = ("--output=", "--write=")


class GuardError(ValueError):
    pass


def repository_root() -> Path:
    completed = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if completed.returncode != 0:
        raise GuardError("repo-openspec must run inside a Git worktree")
    root = Path(completed.stdout.strip()).resolve(strict=True)
    cwd = Path.cwd().resolve(strict=True)
    if cwd != root and root not in cwd.parents:
        raise GuardError("current directory is outside the Git worktree")
    return root


def validate(arguments: list[str]) -> list[str]:
    if not arguments:
        raise GuardError("an OpenSpec command is required")
    if arguments[0] == "store":
        if len(arguments) < 2 or arguments[1] not in {"list", "doctor"}:
            raise GuardError("only 'store list' and 'store doctor' are read-only")
    elif arguments[0] not in ALLOWED_COMMANDS:
        raise GuardError(f"OpenSpec command is not read-only: {arguments[0]}")
    for value in arguments:
        if value in FORBIDDEN_FLAGS or value.startswith(FORBIDDEN_PREFIXES):
            raise GuardError(f"write-capable OpenSpec option is forbidden: {value}")
    return ["openspec", *arguments]


def self_test() -> None:
    allowed = [["list"], ["show", "example"], ["validate", "example"], ["store", "list"]]
    rejected = [["init"], ["archive", "example"], ["store", "add"], ["doctor", "--fix"], ["show", "x", "--output=y"]]
    for arguments in allowed:
        validate(arguments)
    for arguments in rejected:
        try:
            validate(arguments)
        except GuardError:
            continue
        raise AssertionError(f"expected reject: {arguments}")
    print(json.dumps({"status": "PASS", "cases": len(allowed) + len(rejected)}))


def main() -> int:
    arguments = sys.argv[1:]
    if arguments == ["--self-test"]:
        self_test()
        return 0
    dry_run = False
    if arguments and arguments[0] == "--dry-run":
        dry_run = True
        arguments.pop(0)
    repository_root()
    command = validate(arguments)
    if dry_run:
        print(json.dumps({"status": "ALLOW", "command": command}))
        return 0
    if shutil.which("openspec") is None:
        raise GuardError("openspec executable is not available")
    return subprocess.run(command, check=False).returncode


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (GuardError, OSError) as error:
        print(json.dumps({"status": "REJECT", "error": str(error)}), file=sys.stderr)
        raise SystemExit(64)
