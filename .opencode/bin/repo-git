#!/usr/bin/env python3
"""Run Git through an exact, default-deny repo-local argument grammar."""

from __future__ import annotations

from collections.abc import Mapping
from dataclasses import dataclass, field
from enum import Enum
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from typing import NoReturn


class GuardError(ValueError):
    """The requested argv is outside the wrapper contract."""


class ValueType(Enum):
    FLAG = "flag"
    STRING_VALUE = "string"
    INTEGER_VALUE = "integer"
    ENUM_VALUE = "enum"
    REPO_FILE = "repo-file"
    REPO_PATH = "repo-path"


@dataclass(frozen=True)
class OptionSpec:
    value_type: ValueType
    choices: frozenset[str] = frozenset()
    allow_attached: bool = False
    minimum: int = 0
    maximum: int = 10000


@dataclass(frozen=True)
class CommandSpec:
    long_options: Mapping[str, OptionSpec] = field(default_factory=dict)
    short_options: Mapping[str, OptionSpec] = field(default_factory=dict)
    operand_kind: str = "none"
    min_operands: int = 0
    max_operands: int = 0
    paths: str = "none"
    writer: bool = False
    required_any: frozenset[str] = frozenset()


FLAG = OptionSpec(ValueType.FLAG)
STRING = OptionSpec(ValueType.STRING_VALUE)
INTEGER = OptionSpec(ValueType.INTEGER_VALUE, minimum=1)
REPO_FILE = OptionSpec(ValueType.REPO_FILE)
MESSAGE_SHORT = OptionSpec(ValueType.STRING_VALUE, allow_attached=True)
INTEGER_SHORT = OptionSpec(ValueType.INTEGER_VALUE, allow_attached=True, minimum=1)
REPO_FILE_SHORT = OptionSpec(ValueType.REPO_FILE, allow_attached=True)


DIFF_LONG = {
    "--binary": FLAG,
    "--cached": FLAG,
    "--check": FLAG,
    "--compact-summary": FLAG,
    "--exit-code": FLAG,
    "--ignore-revs-file": REPO_FILE,
    "--name-only": FLAG,
    "--name-status": FLAG,
    "--no-renames": FLAG,
    "--numstat": FLAG,
    "--patch": FLAG,
    "--quiet": FLAG,
    "--shortstat": FLAG,
    "--staged": FLAG,
    "--stat": FLAG,
    "--summary": FLAG,
    "--unified": INTEGER,
}
DIFF_SHORT = {"-p": FLAG, "-U": INTEGER_SHORT}
LOG_LONG = {
    "--all": FLAG,
    "--date-order": FLAG,
    "--decorate": FLAG,
    "--first-parent": FLAG,
    "--follow": FLAG,
    "--format": STRING,
    "--graph": FLAG,
    "--ignore-revs-file": REPO_FILE,
    "--max-count": INTEGER,
    "--merges": FLAG,
    "--name-only": FLAG,
    "--name-status": FLAG,
    "--no-decorate": FLAG,
    "--no-merges": FLAG,
    "--oneline": FLAG,
    "--patch": FLAG,
    "--pretty": STRING,
    "--reverse": FLAG,
    "--stat": FLAG,
    "--topo-order": FLAG,
}
LOG_SHORT = {"-n": INTEGER_SHORT, "-p": FLAG}


