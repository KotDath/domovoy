#!/usr/bin/env python3
"""Delete explicit paths strictly inside the current Git worktree."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess


def git_root() -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise SystemExit("repo-rm must run inside a Git worktree")
    return Path(result.stdout.strip()).resolve()


@dataclass(frozen=True)
class Target:
    lexical: Path
    effective: Path
    is_directory: bool


def is_within(path: Path, root: Path) -> bool:
    return path == root or root in path.parents


def validate_target(root: Path, raw: str, recursive: bool) -> Target:
    if any(character in raw for character in "*?[]"):
        raise ValueError("repo-rm refuses shell glob syntax; pass explicit paths")

    lexical = Path(os.path.abspath(Path.cwd() / raw))
    lexical_git = root / ".git"
    if lexical == root or is_within(lexical, lexical_git):
        raise ValueError(f"repo-rm refuses protected repository path: {raw}")

    try:
        parent = lexical.parent.resolve(strict=True)
    except OSError as error:
        raise ValueError(f"repo-rm cannot resolve parent for path: {raw}") from error
    if not is_within(parent, root):
        raise ValueError(f"repo-rm refuses path outside the repository: {raw}")

    try:
        metadata = lexical.lstat()
    except FileNotFoundError as error:
        raise ValueError(f"repo-rm path does not exist: {raw}") from error

    is_symlink = stat.S_ISLNK(metadata.st_mode)
    if is_symlink:
        # Preserve the lexical final component: unlink the symlink itself and
        # never resolve or remove its target, even when that target is external.
        effective = lexical
        is_directory = False
    else:
        effective = lexical.resolve(strict=True)
        if not is_within(effective, root) or is_within(effective, lexical_git):
            raise ValueError(f"repo-rm refuses path outside the repository: {raw}")
        is_directory = stat.S_ISDIR(metadata.st_mode)

    if is_directory and not recursive:
        raise ValueError(f"repo-rm needs --recursive for directory: {raw}")
    return Target(lexical=lexical, effective=effective, is_directory=is_directory)


def reject_overlaps(targets: list[Target]) -> None:
    for index, left in enumerate(targets):
        for right in targets[index + 1 :]:
            lexical_overlap = (
                left.lexical == right.lexical
                or left.lexical in right.lexical.parents
                or right.lexical in left.lexical.parents
            )
            effective_overlap = (
                left.effective == right.effective
                or left.effective in right.effective.parents
                or right.effective in left.effective.parents
            )
            if lexical_overlap or effective_overlap:
                raise ValueError(
                    "repo-rm refuses duplicate or overlapping targets: "
                    f"{left.lexical} and {right.lexical}"
                )


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Remove explicit files, or directories with --recursive, inside this repository"
    )
    parser.add_argument("--recursive", action="store_true")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="validate and print lexical targets without deleting anything",
    )
    parser.add_argument("paths", nargs="+")
    args = parser.parse_args()
    root = git_root()
    try:
        targets = [
            validate_target(root, raw, recursive=args.recursive) for raw in args.paths
        ]
        reject_overlaps(targets)
    except ValueError as error:
        raise SystemExit(str(error)) from error

    if args.dry_run:
        print(
            json.dumps(
                {
                    "status": "DRY_RUN",
                    "targets": [str(target.lexical) for target in targets],
                }
            )
        )
    else:
        for target in targets:
            if target.is_directory:
                shutil.rmtree(target.lexical)
            else:
                target.lexical.unlink()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
